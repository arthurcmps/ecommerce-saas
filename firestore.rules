rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStoreOwner(storeId) {
      return signedIn() && request.auth.uid == storeId;
    }

    function isCustomer() {
      return signedIn() && exists(/databases/$(database)/documents/customers/$(request.auth.uid));
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if isStoreOwner(storeId);
      allow update, delete: if isStoreOwner(storeId);

      match /products/{productId} {
        allow read: if true;
        allow create, delete: if isStoreOwner(storeId);
        allow update: if isStoreOwner(storeId) || (
          isCustomer()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0
          && request.resource.data.stock < resource.data.stock
        );
      }

      match /orders/{orderId} {
        allow create: if isCustomer()
          && request.resource.data.customer_id == request.auth.uid
          && request.resource.data.status == 'novo'
          && request.resource.data.total_amount is number
          && request.resource.data.total_amount >= 0;

        allow read: if isStoreOwner(storeId)
          || (signedIn() && resource.data.customer_id == request.auth.uid);

        allow update: if isStoreOwner(storeId);
        allow delete: if false;
      }
    }

    match /customers/{customerId} {
      allow create: if signedIn() && request.auth.uid == customerId;
      allow read, update, delete: if signedIn() && request.auth.uid == customerId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
